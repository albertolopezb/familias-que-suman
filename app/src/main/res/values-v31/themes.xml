<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ enseña por defecto el ícono de la app al abrir. Aquí se deja en
         blanco y sin ícono, para que lo único que se vea sea el logo completo del
         SplashScreen de la app. -->
    <style name="Theme.FamiliasQueSuman" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
