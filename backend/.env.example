# Opcional. Sin .env todo funciona con valores de DESARROLLO. Cópialo a ".env" para cambiar algo.
# ".env" NO se sube al repo (está en .gitignore); este archivo de ejemplo sí.
#
# En un servidor real: ENTORNO=produccion y TODAS las contraseñas nuevas, largas y al azar.
# Para generar una:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# (En producción la API se niega a arrancar si alguna sigue con "cambia-").

ENTORNO=desarrollo

# ── Base de datos (PostgreSQL) ──
# El dueño: lo usan Flyway y los datos de prueba. La API NUNCA recibe esta contraseña.
POSTGRES_DB=familias
POSTGRES_USER=familias
POSTGRES_PASSWORD=cambia-esta-contrasena
# El usuario con el que entra la API: solo lee y escribe filas (ver db/migrations/afterMigrate.sql).
# Solo letras, números y guiones.
DB_API_USUARIO=familias_api
DB_API_CONTRASENA=cambia-esta-contrasena-api

# ── Auth0 (ver docs/guia-backend.md §4) ──
# El dominio de tu tenant y el identificador de la API que creaste en el panel de Auth0.
AUTH0_DOMINIO=
AUTH0_AUDIENCIA=https://api.familiasquesuman
# Opcional: el Client ID de la app Android. Si se pone, solo se aceptan tokens pedidos por ella.
AUTH0_CLIENTE_APP=

# ── Almacén de fotos (RustFS, compatible con S3) ──
STORAGE_ROOT_USER=familias-almacen
STORAGE_ROOT_PASSWORD=cambia-esta-contrasena-almacen

# ── Redis (rate limit y sesiones cerradas) ──
REDIS_CONTRASENA=cambia-esta-contrasena-redis

# ── Llave para seudonimizar IPs en la bitácora (HMAC-SHA256). Mínimo 32 caracteres. ──
HMAC_SECRETO=cambia-este-secreto-hmac-de-desarrollo

# ── Grafana (http://localhost:3000) ──
GRAFANA_USUARIO=admin
GRAFANA_CONTRASENA=cambia-esta-contrasena-grafana

# ── Enlaces para compartir y App Links ──
# Vacío = la API le pregunta al túnel su dirección (Quick Tunnel). Con dominio propio:
# ENLACES_BASE=https://app.tudominio.mx
ENLACES_BASE=
# Huella SHA-256 del certificado de firma de la app (./gradlew signingReport). Separadas por coma.
APP_HUELLAS_SHA256=
# Solo con túnel con nombre (dominio propio en Cloudflare): el token que da el panel de Cloudflare.
TUNNEL_TOKEN=

# ── Puertos en tu máquina (solo 127.0.0.1). Cámbialos si ya los usa otra cosa. ──
API_PORT=8000
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ── Red de Docker (solo si choca con otra red de tu máquina) ──
RED_BORDE=172.31.250.0/24
IP_TUNEL=172.31.250.10
