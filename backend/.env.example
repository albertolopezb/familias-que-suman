# Copia este archivo a ".env" (cp .env.example .env) y ajusta lo que haga falta.
# ".env" NO se sube al repo; este archivo de ejemplo sí. Estos valores son solo para
# desarrollo en tu máquina: en un servidor real se usan contraseñas distintas y largas.

# Base de datos (PostgreSQL)
POSTGRES_DB=familias
POSTGRES_USER=familias
POSTGRES_PASSWORD=cambia-esta-contrasena

# Almacenamiento de fotos (compatible con S3). La contraseña pide mínimo 8 caracteres.
STORAGE_ROOT_USER=familias-storage
STORAGE_ROOT_PASSWORD=cambia-esta-contrasena-tambien

# Puertos en tu máquina (solo accesibles desde ella). Cámbialos si ya los usa otra cosa.
# Si los cambias, el resto del equipo no se entera: es solo tu .env.
DB_PORT=5432
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001
